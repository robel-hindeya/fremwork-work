# Fremwork AI: copy this file to .env.

# Gemini
GEMINI_API_KEY=your-key-here
GOOGLE_API_KEY=your-key-here
# Choose a model available to this API key; no unverified default is used.
GEMINI_MODEL=
# AI requests per user per day
AI_DAILY_LIMIT=50

# Supabase (one project for the website and the app)
NEXT_PUBLIC_SUPABASE_URL=https://jwznteirgsnebvtswppu.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jSU3BbnNVHojq0teQR8j-A_3Au5k5k6
SUPABASE_URL=https://jwznteirgsnebvtswppu.supabase.co
SUPABASE_KEY=sb_publishable_jSU3BbnNVHojq0teQR8j-A_3Au5k5k6

# Backend API (apps/api): uses SUPABASE_URL and the publishable key below, never a service-role key.
PORT=4000
SUPABASE_ANON_KEY=sb_publishable_jSU3BbnNVHojq0teQR8j-A_3Au5k5k6
# Exact browser origins allowed to call the API (comma-separated). Empty means the Fremwork domains.
CORS_ORIGINS=
# Optional AI fallbacks
GEMINI_FALLBACK_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Website
LANDING_URL=http://localhost:3001
# Exact additional landing origins permitted to transfer a session (comma-separated).
AUTH_HANDOFF_ORIGINS=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_API_URL=http://localhost:4001
SITE_API_PORT=4001


# Website API only
FREMWORK_SUPABASE_URL=https://jwznteirgsnebvtswppu.supabase.co
FREMWORK_SUPABASE_SECRET_KEY=
WEB_URL=http://localhost:3001
RESEND_API_KEY=
EMAIL_FROM=

# Production workspace: use the same project as the landing page. Public key only.
FREMWORK_SUPABASE_PUBLISHABLE_KEY=sb_publishable_jSU3BbnNVHojq0teQR8j-A_3Au5k5k6
